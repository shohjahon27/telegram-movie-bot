# Copy this to .env and fill in your values. Never commit the real .env.
# That's it — no other config files to touch. Run `python bot.py` after this.

# From @BotFather (see README)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Numeric chat id of your mandatory channel, e.g. -1001234567890.
# The bot account MUST be an admin of this channel.
CHANNEL_ID=-1001234567890
# Public username (no @) if the channel is public — used for the Join button.
# Leave blank for a private channel and set an invite link later via /setchannel.
CHANNEL_USERNAME=your_channel_username

# Comma-separated Telegram user IDs to make super-admins on first boot.
# Get your own numeric ID from @userinfobot.
SEED_ADMIN_IDS=111111111,222222222

# MongoDB connection string. This default works out of the box with
# `docker compose up` (see docker-compose.yml). For MongoDB Atlas (free
# tier), paste the connection string Atlas gives you instead.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=movie_bot

# Optional tuning (sensible defaults if omitted)
RATE_LIMIT_PER_MINUTE=20
SUBSCRIPTION_CACHE_SECONDS=600
